+
+
+# ------------------------------------------------- personalised suggestions
+# Tap-to-ask chips for the tutor panel. They are tailored to what the student
+# is doing right now: the chapter they are reading, which practice questions
+# they got wrong / haven't tried, the circuit they last ran, and the last few
+# chat turns. Same grounding rule as everywhere else: the model only sees
+# facts the app actually has, and any failure falls back to templates.
+_PAGES = ("lessons", "simulator", "progress")
+_GENERIC = {
+    "lessons": ["Explain this chapter simply", "Give me an everyday analogy", "What should I learn next?"],
+    "simulator": ["Why does my circuit give these results?", "Is my circuit entangled?", "What should I try next?"],
+    "progress": ["Which topics should I revisit?", "Explain my wrong answers", "Quiz me with a new question"],
+}
+
+
+def _progress_buckets(progress: Optional[Dict[str, Any]]):
+    results = (progress or {}).get("results") or []
+    wrong = [r["chapter"] for r in results if r.get("answered") and not r.get("correct")]
+    todo = [r["chapter"] for r in results if not r.get("answered")]
+    right = [r["chapter"] for r in results if r.get("answered") and r.get("correct")]
+    return wrong, todo, right
+
+
+def _templated_suggestions(page, chapter, context, progress) -> List[str]:
+    wrong, todo, right = _progress_buckets(progress)
+    out: List[str] = []
+    if page == "progress":
+        if wrong:
+            out.append(f'Why did I get "{wrong[0]}" wrong?')
+        if len(wrong) > 1:
+            out.append(f'What connects my mistakes in "{wrong[0]}" and "{wrong[1]}"?')
+        if todo:
+            out.append(f'Give me a hint for "{todo[0]}" without the answer')
+        if right and not wrong and not todo:
+            out.append("Give me a harder challenge")
+        if not wrong and not right:
+            out.append("Where should I start?")
+    elif page == "simulator":
+        gates = (context or {}).get("gates") or []
+        purities = (context or {}).get("purities") or []
+        if not gates:
+            out += ["How do I build my first circuit?", "Which gate should I try first?"]
+        else:
+            if purities and min(purities) < 0.9:
+                out += ["Why does each qubit look mixed on its own?", "Why do only some outcomes show up?"]
+            else:
+                out += ["Why is each qubit still pure here?", "How could I make this circuit entangled?"]
+            names = ", ".join(dict.fromkeys(g.get("type", "?") for g in gates[:4]))
+            out.append(f"What does {names} do to the Bloch arrow?")
+    else:
+        if chapter:
+            if chapter in wrong:
+                out.append("I missed this chapter's question. What am I missing?")
+            out.append(f'Explain "{chapter}" with an everyday analogy')
+            out.append("What's the most common mistake here?")
+            out.append("What should I learn next?" if chapter in right else "Quiz me on this chapter")
+    for g in _GENERIC.get(page, _GENERIC["lessons"]):
+        out.append(g)
+    seen, uniq = set(), []
+    for q in out:
+        if q.lower() not in seen:
+            seen.add(q.lower()); uniq.append(q)
+    return uniq[:3]
+
+
+SUGGEST_SYSTEM = (
+    "You write exactly 3 short questions a student could tap to ask the AI tutor of a quantum-computing "
+    "learning app. Personalise them to the facts you are given: the chapter being read, quiz answers they got "
+    "wrong or have not tried, the circuit they just ran, what they just discussed. Each question: first person, "
+    "at most 14 words, plain text (no LaTeX, no markdown, no numbering), specific rather than generic. Never "
+    "mention a number, gate, result or quiz score that is not in the facts, and do not repeat a question the "
+    "student already asked. Reply with ONLY a JSON array of 3 strings."
+)
+
+
+def _suggest_messages(page, chapter, context, progress, history) -> List[dict]:
+    wrong, todo, right = _progress_buckets(progress)
+    facts: Dict[str, Any] = {"page": page, "chapter_open": chapter}
+    if progress:
+        facts["quiz"] = {"answered": progress.get("answered"), "correct": progress.get("correct"),
+                         "total": progress.get("total"), "got_wrong": wrong, "not_tried": todo, "got_right": right}
+    if page == "simulator" and context:
+        facts["last_circuit"] = {
+            "note": "outcome labels are |q0 q1>, qubit 0 on the left",
+            "gates": context.get("gates"), "purities": context.get("purities"),
+            "probabilities": context.get("probabilities"),
+        }
+    if history:
+        facts["recent_chat"] = [{"role": h.get("role"), "text": str(h.get("content", ""))[:300]}
+                                for h in history[-4:] if h.get("role") in ("user", "assistant")]
+    return [{"role": "system", "content": SUGGEST_SYSTEM},
+            {"role": "user", "content": f"Facts about this student right now: {facts}"}]
+
+
+def _parse_questions(text: str) -> List[str]:
+    m = re.search(r"\[.*\]", text, re.S)
+    arr = json.loads(m.group(0)) if m else []
+    seen, out = set(), []
+    for q in arr:
+        if not isinstance(q, str):
+            continue
+        q = " ".join(q.split())
+        if q and len(q) <= 110 and q.lower() not in seen:
+            seen.add(q.lower()); out.append(q)
+    return out[:3]
+
+
+def suggest_questions(page, chapter, context, progress, history=None):
+    """Returns (questions, source) where source is 'groq' or 'templated'."""
+    page = page if page in _PAGES else "lessons"
+    fallback = _templated_suggestions(page, chapter, context, progress)
+    if not _client:
+        return fallback, "templated"
+    try:
+        qs = _parse_questions(_ask_llm(_suggest_messages(page, chapter, context, progress, history),
+                                       max_tokens=800, timeout=12))
+        if len(qs) >= 2:
+            for f in fallback:  # pad to 3 if the model gave only 2
+                if len(qs) < 3 and f.lower() not in {q.lower() for q in qs}:
+                    qs.append(f)
+            return qs, "groq"
+    except Exception as e:
+        print(f"[ai_tutor] suggestion call failed: {e}")
+    return fallback, "templated"
