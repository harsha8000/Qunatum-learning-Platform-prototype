 /* preload the classic Bell-state demo: H on qubit0 slot0, CNOT control0->target1 slot1 */
 function preload() {
   slotState[0][0] = "H"; gates.push({ type: "H", qubit: 0, slot: 0 }); renderSlot(0, 0);
-  placePair("CNOT", 0, 1);
